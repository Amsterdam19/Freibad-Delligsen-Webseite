---
import Accordion from "../components/Accordion/Accordion.astro";
import OSM from "../components/Index/OSM.astro";
import Verlinkung from "../components/Index/Verlinkung.astro";
import Kurse from "../components/Kurse.astro";
import LandingLogo from "../components/Index/LandingLogo.astro";
import MainLayout from "../layouts/MainLayout.astro";
import Countdown from "components/Countdown.astro";
import Sponsors from "components/Index/Sponsors.astro";
import NewLogo from "components/NewLogo.astro";
---

<MainLayout
    titel="Startseite Freibad Delligsen"
    description="Freibad Delligsen - Schwimmen in der Hilsmulde"
>
    <!-- 
    <NewLogo/>-->
    <LandingLogo slot="landingLogo">
        <div id="quickLink">
            <!--Erst 99 Tage vor Saisonstart 
            <Countdown
                title="Saisonstart"
                date="2026-05-29T18:00:00"
                bg_color="secondary"
            >
                Die Saison startet am 29. Mai 2026.
            </Countdown>-->
            <!--<<Verlinkung href="/job" label="Ferienjob" classes="btn-secondary" /> -->
            <Verlinkung
                href="/veranstaltungen/#WMvs"
                label="Public Viewing 🇩🇪 vs 🇨🇼"
                classes="btn-primary"
            />
            <Verlinkung
                href="/mitglied/"
                label="Vereinsmitglied werden"
                classes="btn-secondary"
            />
        </div>
    </LandingLogo>
    

    <Accordion />
    <!-- Beta
    <Sponsors />
     -->
    <OSM className="full-width" />
    <!--
    <Kurse />
    -->
</MainLayout>

<style>
    :root {
        --indexBRadius: var(--border-radius);
    }


    #quickLink {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        margin-top: 30px;
        align-items: center;
        gap: 2rem 1rem;
        transition: all 0.2s ease-in;
        opacity: 0;
        animation: 0.5s cubic-bezier(0, 0, 0.34, 0.96) 1s forwards slideup;
    }

    @keyframes slideup {
        from {
            transform: translateY(100px);
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
</style>
