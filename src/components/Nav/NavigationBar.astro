---
import NavItem from "./NavbarItem.astro";

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.split("/");
const { className } = Astro.props;
---

<div class:list={["drawer z-50", {"hidden" : currentPath[1]==""}, "xl:grid"]}>
    <div class="drawer-content flex flex-col">
        <!-- Navbar -->
        <div class=" " class:list={["navbar pb-10 pt-4 px-0 w-full justify-center", {"md:justify-between justify-between" : currentPath[1]}]}>
            {currentPath[1] ? 
            <a class="no-underline" href="/" transition:name="nav-logo">
                <h4>Freibad Delligsen</h4>
            </a>
             : <div style="display: none;"></div>}
            <div class="hidden flex-none xl:block">
                <ul id="desktop-nav-ul" class="menu menu-horizontal gap-2 box-s-3">
                    <!-- Navbar menu content here -->
                    {currentPath[1] ? 
                        <NavItem
                        title="Startseite"
                        url=""
                        current={currentPath[1]}
                    />
                         : ""}
                    <NavItem
                        title="Öffnungszeiten"
                        url="zeiten"
                        current={currentPath[1]}
                    />
                    <NavItem
                        title="Eintrittspreise"
                        url="preise"
                        current={currentPath[1]}
                    />
                    <NavItem
                        title="Veranstaltungen"
                        url="veranstaltungen"
                        current={currentPath[1]}
                    />
                    <NavItem
                        title="Neuigkeiten"
                        url="neues"
                        current={currentPath[1]}
                    />
                    <NavItem
                        title="Galerie"
                        url="galerie"
                        current={currentPath[1]}
                    />
                </ul>
            </div>
        </div>
        <!-- Page content here -->
    </div>
</div>

<style>
    #desktop-nav-ul {
        background-color: white;
        border-radius: 50rem;
        padding: .3rem;
    }

    h4 {
        font-size: clamp(1.5rem, 1.4082rem + 0.4898vw, 1.8rem);
        font-weight: 900;
        letter-spacing: -0.2px;
    }
</style>
